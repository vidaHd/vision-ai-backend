# Optional local overrides when running the API outside Docker Compose.
# Prefer the project-root .env.example for `docker compose` setups.

LLM_PROVIDER=openai_compatible
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
# Compose network: http://ollama:11434/v1
# Host machine:     http://127.0.0.1:11434/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_TIMEOUT_SECONDS=120

# Local backend against published Postgres port:
DATABASE_URL=postgresql+psycopg://vision:change-me@localhost:5432/vision_ai

# Redis / Celery (published Redis port from compose)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Auth (required — generate a long random string for production)
SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Apply migrations from the host:
#   DATABASE_URL=postgresql+psycopg://vision:change-me@localhost:5432/vision_ai alembic upgrade head
#
# Run a Celery worker locally (API + Redis must be reachable):
#   celery -A app.workers.celery_app.celery_app worker --loglevel=info --concurrency=1
